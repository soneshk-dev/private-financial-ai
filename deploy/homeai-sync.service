# ~/.config/systemd/user/homeai-sync.service
[Unit]
Description=homeai daily sync (connectors, transfer pairing, snapshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/pfa
Environment=HOMEAI_PRIVATE_DIR=%h/pfa/private
Environment=HOMEAI_VAULT_DIR=%h/homeai-vault
ExecStart=%h/pfa/.venv/bin/homeai sync
TimeoutStartSec=1800
